# JozmozDNS Telegram Bot systemd unit.
#
# This service runs the Telegram Sales & Subscription Bot as a companion to the
# main JozmozDNS service. It reads its configuration (bot token, admin IDs, payment
# details, trial settings) from the JozmozDNS panel database via the REST API.
#
# Prerequisites:
#   1. The main JozmozDNS service must be running (it provides the REST API).
#   2. JozmozDNS_API_KEY must be set in the environment file.
#   3. Python 3 and the 'requests' package must be installed.
#   4. Telegram bot settings must be configured in the JozmozDNS Dashboard.

[Unit]
Description=JozmozDNS Telegram Sales & Subscription Bot
Documentation=https://github.com/jozmoz/JozmozDNS
After=JozmozDNS.service
Wants=JozmozDNS.service

[Service]
Type=simple
User=root
WorkingDirectory=/opt/JozmozDNS
EnvironmentFile=-/opt/JozmozDNS/telegram.env
ExecStart=/usr/bin/python3 /opt/JozmozDNS/integrations/telegram_bot.py
Restart=always
RestartSec=10s
TimeoutStopSec=10s
SyslogIdentifier=JozmozDNS-bot

[Install]
WantedBy=multi-user.target
